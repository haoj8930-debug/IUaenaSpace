{"id":2027984220,"title":"Love poem","artist":"IU","release":"IU CLIP","albumId":159560050,"credits":[],"lines":[{"time":16989,"timeLabel":"0:16","original":"누구를 위해 누군가","translation":"应是有谁在为某人"},{"time":24531,"timeLabel":"0:24","original":"기도하고 있나 봐","translation":"祈祷着吧"},{"time":32516,"timeLabel":"0:32","original":"숨죽여 쓴 사랑시가","translation":"屏息写成的爱之诗篇"},{"time":40271,"timeLabel":"0:40","original":"낮게 들리는 듯해","translation":"好像低声传来"},{"time":45916,"timeLabel":"0:45","original":"너에게로 선명히 날아가","translation":"愿它清晰地朝你飞去"},{"time":53624,"timeLabel":"0:53","original":"늦지 않게 자리에 닿기를","translation":"不要迟到 准时抵达"},{"time":63428,"timeLabel":"1:03","original":"I'll be there 홀로 걷는 너의 뒤에","translation":"I'll be there 在踽踽独行的你身后"},{"time":71414,"timeLabel":"1:11","original":"Singing till the end 그치지 않을 이 노래","translation":"Singing till the end 这首歌不会停歇"},{"time":79190,"timeLabel":"1:19","original":"아주 잠시만 귀 기울여 봐","translation":"只需片刻 请你侧耳倾听"},{"time":87174,"timeLabel":"1:27","original":"유난히 긴 밤을 걷는 널 위해 부를게","translation":"为了行走在尤为漫长的夜里的你，我将歌唱"},{"time":110423,"timeLabel":"1:50","original":"또 한 번 너의 세상에","translation":"应是你的世界又一次"},{"time":119542,"timeLabel":"1:59","original":"별이 지고 있나 봐","translation":"坠落着星星吧"},{"time":127318,"timeLabel":"2:07","original":"숨죽여 삼킨 눈물이","translation":"屏息强忍住的泪水"},{"time":134817,"timeLabel":"2:14","original":"여기 흐르는 듯해","translation":"好像流淌于此"},{"time":140738,"timeLabel":"2:20","original":"할 말을 잃어 고요한 마음에","translation":"默默失语的孤寂心灵之中"},{"time":148784,"timeLabel":"2:28","original":"기억처럼 들려오는 목소리","translation":"如记忆般传来的那个声音"},{"time":157062,"timeLabel":"2:37","original":"I'll be there 홀로 걷는 너의 뒤에","translation":"I'll be there 在踽踽独行的你身后"},{"time":164257,"timeLabel":"2:44","original":"Singing till the end 그치지 않을 이 노래","translation":"Singing till the end 这首歌不会停歇"},{"time":172097,"timeLabel":"2:52","original":"아주 커다란 숨을 쉬어 봐","translation":"试着大口大口地呼吸吧"},{"time":179523,"timeLabel":"2:59","original":"소리 내 우는 법을 잊은 널 위해 부를게","translation":"为了已经忘记如何放声哭泣的你，我将歌唱"},{"time":189362,"timeLabel":"3:09","original":"(다시 걸어갈 수 있도록)","translation":"(让你能够再次前行)"},{"time":195112,"timeLabel":"3:15","original":"부를게","translation":"我将歌唱"},{"time":197134,"timeLabel":"3:17","original":"(다시 사랑할 수 있도록)","translation":"(让你能够再次去爱)"},{"time":203610,"timeLabel":"3:23","original":"Here i am 지켜봐 나를, 난 절대","translation":"Here i am 请看着我吧 我绝对会"},{"time":210603,"timeLabel":"3:30","original":"Singing till the end 멈추지 않아 이 노래","translation":"Singing till the end 这首歌不会停歇"},{"time":218149,"timeLabel":"3:38","original":"너의 긴 밤이 끝나는 그날","translation":"你长夜结束的那天"},{"time":226573,"timeLabel":"3:46","original":"고개를 들어 바라본 그곳에 있을게","translation":"我将会在抬头可见的那个地方"},{"time":252786,"timeLabel":"4:12","original":"누구를 위해 누군가","translation":"应是有谁在为某人"},{"time":261570,"timeLabel":"4:21","original":"기도하고 있나 봐","translation":"祈祷着吧"},{"time":270338,"timeLabel":"4:30","original":"숨죽여 쓴 사랑시가","translation":"屏息写成的爱之诗篇"},{"time":280475,"timeLabel":"4:40","original":"네게 들렸으면 해","translation":"愿你能听见"}]}
