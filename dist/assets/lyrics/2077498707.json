{"id":2077498707,"title":"My sea","artist":"IU","release":"IU CLIP","albumId":159560050,"credits":[],"lines":[{"time":782,"timeLabel":"0:00","original":"그러나 시간이 지나도","translation":"然而 即使时光流逝"},{"time":7836,"timeLabel":"0:07","original":"아물지 않는 일들이 있지","translation":"有些事也无法治愈"},{"time":14957,"timeLabel":"0:14","original":"내가 날 온전히 사랑하지 못해서","translation":"因为我无法全然地去爱自己"},{"time":22587,"timeLabel":"0:22","original":"맘이 가난한 밤이야","translation":"内心贫瘠的夜晚啊"},{"time":30025,"timeLabel":"0:30","original":"거울 속에 마주친 얼굴이 어색해서","translation":"因为镜中对视的脸很尴尬"},{"time":37268,"timeLabel":"0:37","original":"습관처럼 조용히 눈을 감아","translation":"所以习惯性地默默闭上双眼"},{"time":44267,"timeLabel":"0:44","original":"밤이 되면 서둘러 내일로 가고 싶어","translation":"一到晚上就盼着明天的到来"},{"time":49633,"timeLabel":"0:49","original":"수많은 소원 아래 매일 다른 꿈을 꾸던","translation":"怀着无数愿望 每天做不同的梦"},{"time":57723,"timeLabel":"0:57","original":"아이는 그렇게 오랜 시간","translation":"孩子就那样度过漫长岁月"},{"time":64604,"timeLabel":"1:04","original":"겨우 내가 되려고 아팠던 걸까","translation":"只是为了变成我而痛苦吗"},{"time":71786,"timeLabel":"1:11","original":"쌓이는 하루만큼 더 멀어져","translation":"日积月累 我们渐行渐远"},{"time":79023,"timeLabel":"1:19","original":"우리는 화해할 수 없을 것 같아","translation":"我们好像无法和解"},{"time":87054,"timeLabel":"1:27","original":"나아지지 않을 것 같아","translation":"好像也不会好转了"},{"time":93006,"timeLabel":"1:33","original":"어린 날 내 맘엔 영원히","translation":"儿时 我的心中"},{"time":100314,"timeLabel":"1:40","original":"가물지 않는 바다가 있었지","translation":"曾有一片永不干涸的大海"},{"time":107424,"timeLabel":"1:47","original":"이제는 흔적만이 남아 희미한 그곳엔","translation":"现在只剩下痕迹 在那隐约的地方"},{"time":119031,"timeLabel":"1:59","original":"설렘으로 차오르던 나의 숨소리와","translation":"因激动而急促的呼吸声和"},{"time":126117,"timeLabel":"2:06","original":"머리 위로 선선히 부는 바람","translation":"头顶吹过的凉爽的风"},{"time":132937,"timeLabel":"2:12","original":"파도가 되어 어디로든 달려가고 싶어","translation":"想幻化成波浪 奔到任何地方"},{"time":138487,"timeLabel":"2:18","original":"작은 두려움 아래 천천히 두 눈을 뜨면","translation":"在小小的恐惧下 慢慢睁开双眼"},{"time":146562,"timeLabel":"2:26","original":"세상은 그렇게 모든 순간","translation":"就那样 世界上所有瞬间"},{"time":153649,"timeLabel":"2:33","original":"내게로 와 눈부신 선물이 되고","translation":"都变成耀眼的礼物来到我身边"},{"time":160696,"timeLabel":"2:40","original":"숱하게 의심하던 나는 그제야","translation":"曾多次迟疑过的我 才终于"},{"time":167869,"timeLabel":"2:47","original":"나에게 대답할 수 있을 것 같아","translation":"好像可以回答自己了"},{"time":176765,"timeLabel":"2:56","original":"선 너머에 기억이","translation":"线那端的记忆"},{"time":183855,"timeLabel":"3:03","original":"나를 부르고 있어","translation":"在呼唤着我"},{"time":190858,"timeLabel":"3:10","original":"아주 오랜 시간 동안","translation":"是长久以来"},{"time":197995,"timeLabel":"3:17","original":"잊고 있던 목소리에","translation":"曾被遗忘过的声音"},{"time":205119,"timeLabel":"3:25","original":"(물결을 거슬러 나 돌아가)","translation":"（逆流而上 我要回去）"},{"time":212257,"timeLabel":"3:32","original":"내 안의 바다가 태어난 곳으로","translation":"回到我内心的大海诞生的地方"},{"time":219375,"timeLabel":"3:39","original":"휩쓸려 길을 잃어도 자유로와","translation":"即使被浪卷走 迷失也是自由的"},{"time":226412,"timeLabel":"3:46","original":"더이상 날 가두는 어둠에 눈 감지 않아","translation":"不再对禁锢我的黑暗闭上眼睛"},{"time":262922,"timeLabel":"4:22","original":"두 번 다시 날 모른 척 하지 않아 Oh","translation":"也不会再对自己视若无睹"},{"time":286141,"timeLabel":"4:46","original":"그럼에도 여전히 가끔은","translation":"尽管如此 偶尔还是"},{"time":293203,"timeLabel":"4:53","original":"삶에게 지는 날들도 있겠지","translation":"会有败给生活的一天吧"},{"time":300353,"timeLabel":"5:00","original":"또다시 헤매일지라도 돌아오는 길을 알아","translation":"即使再次迷失 我也知道回来的路"}]}
