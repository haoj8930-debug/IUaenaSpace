{"id":1404511139,"title":"Love poem","artist":"IU","release":"Love poem","albumId":83487317,"credits":["作词 : IU","作曲 : 이종훈"],"lines":[{"time":17304,"timeLabel":"0:17","original":"누구를 위해 누군가","translation":"应是有谁"},{"time":24824,"timeLabel":"0:24","original":"기도하고 있나 봐","translation":"在为谁祈祷着吧"},{"time":32558,"timeLabel":"0:32","original":"숨죽여 쓴 사랑시가","translation":"仿若屏息而写的情诗"},{"time":40558,"timeLabel":"0:40","original":"낮게 들리는 듯해","translation":"隐隐入耳"},{"time":46126,"timeLabel":"0:46","original":"너에게로 선명히 날아가","translation":"分明地向你的方向而去"},{"time":53859,"timeLabel":"0:53","original":"늦지 않게 자리에 닿기를","translation":"愿不会迟至那里"},{"time":64073,"timeLabel":"1:04","original":"I’ll be there 홀로 걷는 너의 뒤에","translation":"I’ll be there 在独自而行的你身后"},{"time":71375,"timeLabel":"1:11","original":"Singing till the end 그치지 않을 이 노래","translation":"Singing till the end 这首歌不会停息"},{"time":79094,"timeLabel":"1:19","original":"아주 잠시만 귀 기울여 봐","translation":"即使只片刻 请倾耳凝听"},{"time":87093,"timeLabel":"1:27","original":"유난히 긴 밤을 걷는 널 위해 부를게","translation":"我将歌唱，为走过犹为漫长之夜的你"},{"time":111894,"timeLabel":"1:51","original":"또 한 번 너의 세상에","translation":"你的世界应又一次"},{"time":119864,"timeLabel":"1:59","original":"별이 지고 있나 봐","translation":"坠落了星辰"},{"time":127406,"timeLabel":"2:07","original":"숨죽여 삼킨 눈물이","translation":"仿若屏息隐忍的泪水"},{"time":135431,"timeLabel":"2:15","original":"여기 흐르는 듯해","translation":"在此处流淌"},{"time":140918,"timeLabel":"2:20","original":"할 말을 잃어 고요한 마음에","translation":"静寂无言的心中"},{"time":148630,"timeLabel":"2:28","original":"기억처럼 들려오는 목소리","translation":"仿若记忆般传来的声音"},{"time":157347,"timeLabel":"2:37","original":"I’ll be there 홀로 걷는 너의 뒤에","translation":"I’ll be there 在独自而行的你身后"},{"time":164150,"timeLabel":"2:44","original":"Singing till the end 그치지 않을 이 노래","translation":"Singing till the end 这首歌不会停息"},{"time":171999,"timeLabel":"2:51","original":"아주 커다란 숨을 쉬어 봐","translation":"请深深呼吸"},{"time":179621,"timeLabel":"2:59","original":"소리 내 우는 법을 잊은 널 위해 부를게","translation":"我将歌唱，为已忘却可放声哭泣的你"},{"time":189279,"timeLabel":"3:09","original":"(다시 걸어갈 수 있도록)","translation":"（为可再前行）"},{"time":195273,"timeLabel":"3:15","original":"부를게","translation":"我将歌唱"},{"time":197033,"timeLabel":"3:17","original":"(다시 사랑할 수 있도록)","translation":"（为可再爱）"},{"time":203800,"timeLabel":"3:23","original":"Here i am 지켜봐 나를, 난 절대","translation":"Here i am 请看着我吧，我绝不会"},{"time":210603,"timeLabel":"3:30","original":"Singing till the end 멈추지 않아 이 노래","translation":"Singing till the end 将这首歌停息"},{"time":218364,"timeLabel":"3:38","original":"너의 긴 밤이 끝나는 그날","translation":"到你长夜结束的那天"},{"time":226082,"timeLabel":"3:46","original":"고개를 들어 바라본 그곳에 있을게","translation":"我将在抬头即见的那方"}]}
