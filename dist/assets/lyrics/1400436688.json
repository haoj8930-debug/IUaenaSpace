{"id":1400436688,"title":"Love poem","artist":"IU","release":"Love poem","albumId":82923077,"credits":["作词 : IU","作曲 : 이종훈","和声：河东均"],"lines":[{"time":16578,"timeLabel":"0:16","original":"누구를 위해 누군가","translation":"应是有谁"},{"time":24571,"timeLabel":"0:24","original":"기도하고 있나 봐","translation":"在为谁祈祷着吧"},{"time":32229,"timeLabel":"0:32","original":"숨죽여 쓴 사랑시가","translation":"仿若屏息而写的情诗"},{"time":40081,"timeLabel":"0:40","original":"낮게 들리는 듯해","translation":"隐隐入耳"},{"time":45785,"timeLabel":"0:45","original":"너에게로 선명히 날아가","translation":"分明地向你的方向而去"},{"time":53509,"timeLabel":"0:53","original":"늦지 않게 자리에 닿기를","translation":"愿不会迟至那里"},{"time":63960,"timeLabel":"1:03","original":"I’ll be there 홀로 걷는 너의 뒤에","translation":"I’ll be there 在独自而行的你身后"},{"time":70969,"timeLabel":"1:10","original":"Singing till the end 그치지 않을 이 노래","translation":"Singing till the end 这首歌不会停息"},{"time":78752,"timeLabel":"1:18","original":"아주 잠시만 귀 기울여 봐","translation":"即使只片刻 请倾耳聆听"},{"time":86703,"timeLabel":"1:26","original":"유난히 긴 밤을 걷는 널 위해 부를게","translation":"我将歌唱，为走过尤为漫长之夜的你"},{"time":111463,"timeLabel":"1:51","original":"또 한 번 너의 세상에","translation":"你的世界应又一次"},{"time":119203,"timeLabel":"1:59","original":"별이 지고 있나 봐","translation":"坠落了星辰"},{"time":126926,"timeLabel":"2:06","original":"숨죽여 삼킨 눈물이","translation":"仿若屏息隐忍的泪水"},{"time":134605,"timeLabel":"2:14","original":"여기 흐르는 듯해","translation":"在此处流淌"},{"time":140368,"timeLabel":"2:20","original":"할 말을 잃어 고요한 마음에","translation":"静寂无言的心中"},{"time":148344,"timeLabel":"2:28","original":"기억처럼 들려오는 목소리","translation":"仿若记忆般传来的声音"},{"time":157024,"timeLabel":"2:37","original":"I’ll be there 홀로 걷는 너의 뒤에","translation":"I’ll be there 在独自而行的你身后"},{"time":163742,"timeLabel":"2:43","original":"Singing till the end 그치지 않을 이 노래","translation":"Singing till the end 这首歌不会停息"},{"time":171586,"timeLabel":"2:51","original":"아주 커다란 숨을 쉬어 봐","translation":"请深深呼吸"},{"time":179229,"timeLabel":"2:59","original":"소리 내 우는 법을 잊은 널 위해 부를게","translation":"我将歌唱，为已忘却可放声哭泣的你"},{"time":188802,"timeLabel":"3:08","original":"(다시 걸어갈 수 있도록)","translation":"（为可再前行）"},{"time":194703,"timeLabel":"3:14","original":"부를게","translation":"我将歌唱"},{"time":196608,"timeLabel":"3:16","original":"(다시 사랑할 수 있도록)","translation":"（为可再爱）"},{"time":203446,"timeLabel":"3:23","original":"Here I am 지켜봐 나를","translation":"Here i am 请看着我吧"},{"time":208921,"timeLabel":"3:28","original":"난 절대","translation":"我绝对"},{"time":210387,"timeLabel":"3:30","original":"Singing till the end 멈추지 않아 이 노래","translation":"Singing till the end 这首歌不会停息"},{"time":218046,"timeLabel":"3:38","original":"너의 긴 밤이 끝나는 그날","translation":"到你长夜结束的那天"},{"time":225967,"timeLabel":"3:45","original":"고개를 들어 바라본 그곳에 있을게","translation":"我将在抬头即见的那方"}]}
