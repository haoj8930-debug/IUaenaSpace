{"id":26111431,"title":"여자라서","artist":"IU","release":"로드 넘버원 OST Part.3","albumId":2389145,"credits":["作词 : 고릴라","作曲 : 신형, 김희원","编曲 : 김희원/신형"],"lines":[{"time":15810,"timeLabel":"0:15","original":"가득 고인 내 눈물...넘쳐흐르기 전에","translation":"我积满的眼泪留下来之前"},{"time":23000,"timeLabel":"0:23","original":"아무 말 하지 말고...뒤돌아가세요","translation":"什么都不要说请转身离开"},{"time":30430,"timeLabel":"0:30","original":"그대 있을 자리가...내 곁은 아닌걸요","translation":"那时位置不会是我的旁边了"},{"time":37000,"timeLabel":"0:37","original":"여자라서...여자라서.... 붙잡고 싶지만","translation":"因为是女人...因为是女人...虽然很挽留"},{"time":44330,"timeLabel":"0:44","original":"사랑이 지나간 패여 버린 가슴에....","translation":"爱情的离去 心中满是伤痕"},{"time":51770,"timeLabel":"0:51","original":"언제쯤 새살이 상처위에 돋아 날까요","translation":"也许有一天伤口会愈合"},{"time":59120,"timeLabel":"0:59","original":"한방울...두방울 눈물로 그댈 지워갈께요","translation":"一滴...两滴 用泪水擦掉那时候"},{"time":67330,"timeLabel":"1:07","original":"어느날엔가...내눈물이 마를때 까지","translation":"到什么时候...直到我的泪流干为止"},{"time":82350,"timeLabel":"1:22","original":"거짓말을 잘하죠...여자란게 그래요","translation":"擅长说谎话...女人就是这样"},{"time":89440,"timeLabel":"1:29","original":"붙잡고만 싶어도...떠나라하네요","translation":"明明想挽留却让你走"},{"time":96930,"timeLabel":"1:36","original":"그대있던 자리가 ...눈물로 다 젖어도","translation":"那时的位置就算用泪水浸湿"},{"time":103440,"timeLabel":"1:43","original":"여자라서...여자라서...참아낼뿐이죠","translation":"因为是女人...因为是女人...只是仅仅去忍受"},{"time":110880,"timeLabel":"1:50","original":"사랑이 지나간 패여 버린 가슴에....","translation":"爱情的离去 心中满是伤痕"},{"time":118170,"timeLabel":"1:58","original":"언제쯤 새살이 상처위에 돋아 날까요","translation":"也许有一天伤口会愈合"},{"time":125550,"timeLabel":"2:05","original":"한방울...두방울 눈물로 그댈 지워갈께요","translation":"一滴...两滴 用泪水擦掉那时候"},{"time":133840,"timeLabel":"2:13","original":"아주 먼훗날...그눈물이 마를때 까지","translation":"很久很久的一天...直到我的泪流干为止"},{"time":142830,"timeLabel":"2:22","original":"돌아보지 말아요 그대 얼굴을 보면...","translation":"请不要转身 如果看到你的脸"},{"time":150420,"timeLabel":"2:30","original":"참지 못하고....오","translation":"我忍不住会....噢...."},{"time":155360,"timeLabel":"2:35","original":"떠나지 말라고 애원할지 몰라요","translation":"也许会哀愿奢望你不要走"},{"time":162500,"timeLabel":"2:42","original":"달래온 눈물이 터져버릴지도 몰라요","translation":"忍着的眼泪也许会流出来"},{"time":169940,"timeLabel":"2:49","original":"사랑은 알아도...이별은 정말 모르고 싶은","translation":"只想直到爱情不想去了解离别"},{"time":180020,"timeLabel":"3:00","original":"여자이기에...그게 나라는 여자예요","translation":"这就是女人...我就是这样的女人"}]}
